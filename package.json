{
  "name": "video-editer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, browser-based manual video cutter with Arabic controls.",
  "scripts": {
    "prepare:core": "node scripts/prepare-core.mjs",
    "dev": "npm run prepare:core && vite --host 127.0.0.1",
    "build": "npm run prepare:core && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "22.x"
  }
}
